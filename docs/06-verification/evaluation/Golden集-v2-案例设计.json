{
  "setId": "poc04-golden-v2-cases",
  "version": "v2-cases",
  "frozenAt": "2026-11-08",
  "criteriaRef": "技术选型 v1.1 §7 #4（≥30 条覆盖 query/lookup/lookup_batch/funnel/yoy_mom，逐字比对 100%）",
  "note": "M2/T1.2 交付：只冻结【案例 DSL 与预期语义形状】。规范化 SQL 字符串在各模式构造器落地后由编译器生成、人工审阅后回填 sqlExpected 字段并升版 v2-gold（判据是逐字比对，预期 SQL 必须来自实现后的人工审阅，不允许现在手写猜测）。资产锚点全部来自首发清单 2026.11.08-first。",
  "assetAnchors": {
    "manifestId": "2026.11.08-first",
    "metrics": ["metric.gmv", "metric.gmv_created", "metric.order_count", "metric.distinct_customers", "metric.avg_order_value", "metric.refund_amount", "metric.high_value_customer"],
    "dimensions": ["dim.region", "dim.channel", "dim.order_date", "dim.customer_tier", "dim.product_category"]
  },
  "cases": [
    { "id": "g-q01", "mode": "query", "dsl": { "metricId": "metric.gmv", "dimensions": ["dim.region"], "time": "近 30 天" }, "expectShape": "SUM(amount) GROUP BY region LIMIT" },
    { "id": "g-q02", "mode": "query", "dsl": { "metricId": "metric.gmv", "dimensions": ["dim.region", "dim.channel"], "time": "上个月" }, "expectShape": "SUM GROUP BY region,channel" },
    { "id": "g-q03", "mode": "query", "dsl": { "metricId": "metric.order_count", "dimensions": [], "time": "今年" }, "expectShape": "COUNT_DISTINCT(id) 无分组" },
    { "id": "g-q04", "mode": "query", "dsl": { "metricId": "metric.avg_order_value", "dimensions": ["dim.channel"], "filters": [{ "fieldId": "dim.region", "op": "EQ", "value": "华东" }] }, "expectShape": "AVG(amount) WHERE region=?" },
    { "id": "g-q05", "mode": "query", "dsl": { "metricId": "metric.refund_amount", "dimensions": ["dim.order_date"], "time": "近 7 天" }, "expectShape": "SUM(refund_amount) GROUP BY date" },
    { "id": "g-q06", "mode": "query", "dsl": { "metricId": "metric.distinct_customers", "dimensions": ["dim.customer_tier"], "time": "上个月" }, "expectShape": "COUNT_DISTINCT(customer_id) GROUP BY tier" },
    { "id": "g-q07", "mode": "query", "dsl": { "metricId": "metric.gmv", "dimensions": ["dim.region"], "filters": [{ "fieldId": "dim.channel", "op": "IN", "values": ["线上", "线下"] }] }, "expectShape": "SUM WHERE channel IN (?,?)" },
    { "id": "g-q08", "mode": "query", "dsl": { "metricId": "metric.gmv_created", "dimensions": ["dim.order_date"], "time": "近 30 天" }, "expectShape": "下单口径 SUM（独立指标资产）" },
    { "id": "g-l01", "mode": "lookup", "dsl": { "entity": "concept.customer", "identity": { "propertyId": "property.customer.customer_id", "value": "c-1001" } }, "expectShape": "SELECT props WHERE id=? LIMIT 1；email 列 mask（displayHints）" },
    { "id": "g-l02", "mode": "lookup", "dsl": { "entity": "concept.order", "identity": { "propertyId": "property.order.order_no", "value": "o-1" } }, "expectShape": "单订单投影" },
    { "id": "g-l03", "mode": "lookup", "dsl": { "entity": "concept.product", "identity": { "propertyId": "property.product.product_id", "value": "p-1" } }, "expectShape": "单商品投影" },
    { "id": "g-l04", "mode": "lookup", "dsl": { "entity": "concept.customer", "identity": { "propertyId": "property.customer.email", "value": "zhang@example.com" }, "existenceSensitive": true }, "expectShape": "PII+存在性敏感：可查不可看值，缺失不泄露存在性差异" },
    { "id": "g-b01", "mode": "lookup_batch", "dsl": { "entity": "concept.customer", "identities": ["c-1001", "c-1002", "c-1003"] }, "expectShape": "WHERE id IN (?,?,?)，逐行投影；缺失行标注不存在" },
    { "id": "g-b02", "mode": "lookup_batch", "dsl": { "entity": "concept.order", "identities": ["o-1", "o-2", "o-9"] }, "expectShape": "o-9 属 other 租户 → RLS 后不可见，行级存在性保护" },
    { "id": "g-b03", "mode": "lookup_batch", "dsl": { "entity": "concept.product", "identities": ["p-1", "p-2"] }, "expectShape": "商品批量投影" },
    { "id": "g-b04", "mode": "lookup_batch", "dsl": { "entity": "concept.customer", "identities": ["c-1001"], "booleanMetric": "metric.high_value_customer" }, "expectShape": "布尔判定列 = Rule 子查询展开（HAVING SUM>=50000）" },
    { "id": "g-f01", "mode": "funnel", "dsl": { "steps": ["ORDER_PLACED", "REFUND"], "entity": "concept.customer", "time": "近 30 天" }, "expectShape": "步进 CTE s1/s2，每步 count 与转化" },
    { "id": "g-f02", "mode": "funnel", "negative": "步骤数不足（steps < 2）", "dsl": { "steps": ["ORDER_PLACED"], "entity": "concept.customer", "time": "上个月" }, "expectShape": "DSL_INVALID 拒绝（analysis-mode 规格 v1 §1.1）", "amendedBy": "ADR-0011" },
    { "id": "g-f03", "mode": "funnel", "dsl": { "steps": ["ORDER_PLACED", "ORDER_PLACED"], "entity": "concept.customer", "time": "近 7 天" }, "expectShape": "重复步骤 → 校验拒绝（负例）" },
    { "id": "g-f04", "mode": "funnel", "dsl": { "steps": ["ORDER_PLACED", "REFUND"], "entity": "concept.customer", "time": "今年", "groupBy": ["dim.region"] }, "expectShape": "漏斗 + 维度分组" },
    { "id": "g-y01", "mode": "yoy_mom", "dsl": { "metricId": "metric.gmv", "dimensions": ["dim.region"], "period": "MONTH" }, "expectShape": "窗口 lag 同比+环比双列" },
    { "id": "g-y02", "mode": "yoy_mom", "dsl": { "metricId": "metric.order_count", "dimensions": [], "period": "MONTH" }, "expectShape": "总量同环比" },
    { "id": "g-y03", "mode": "yoy_mom", "dsl": { "metricId": "metric.gmv", "dimensions": ["dim.channel"], "period": "YEAR" }, "expectShape": "年粒度同比" },
    { "id": "g-y04", "mode": "yoy_mom", "dsl": { "metricId": "metric.avg_order_value", "dimensions": ["dim.region"], "period": "MONTH" }, "expectShape": "客单价同环比" },
    { "id": "g-n01", "mode": "query", "negative": "metricId 不在清单", "expectShape": "ASSET_NOT_FOUND 拒绝" },
    { "id": "g-n02", "mode": "query", "negative": "dimensions 引用未授权维度", "expectShape": "DIMENSION_NOT_ALLOWED 拒绝" },
    { "id": "g-n03", "mode": "lookup_batch", "negative": "批量大小超上限", "expectShape": "BATCH_LIMIT 拒绝" },
    { "id": "g-n04", "mode": "query", "negative": "timeRange 含绝对日期且无 explicit_range 标记", "expectShape": "ABSOLUTE_DATE 拒绝" },
    { "id": "g-n05", "mode": "funnel", "negative": "实体跨授权域", "expectShape": "授权子图外拒绝" },
    { "id": "g-n06", "mode": "query", "negative": "未知字段", "expectShape": "UNKNOWN_FIELD 拒绝（对齐发布链路同款策略）" }
  ]
}
