  "semantic": {
    "metrics": [
      {
        "id": "metric.gmv",
        "name": "GMV",
        "aliases": [
          "成交金额",
          "成交额",
          "销售额",
          "流水",
          "卖了多少",
          "营收"
        ],
        "summary": "成交金额：已支付订单的金额合计",
        "sensitive": false,
        "aggregation": "SUM",
        "allowedModes": [
          "QUERY",
          "LOOKUP",
          "YOY_MOM",
          "ATTRIBUTION"
        ],
        "allowedDimensions": [
          "dim.region",
          "dim.channel",
          "dim.channel_name",
          "dim.order_date",
          "dim.customer_tier",
          "dim.product_category"
        ],
        "objectId": "concept.order",
        "propertyId": "property.order.amount"
      },
      {
        "id": "metric.paid_gmv",
        "name": "已支付 GMV",
        "aliases": [
          "支付GMV",
          "已支付成交额",
          "支付金额"
        ],
        "summary": "已支付订单的成交金额合计，可按渠道口径细分",
        "sensitive": false,
        "aggregation": "SUM",
        "allowedModes": [
          "QUERY",
          "YOY_MOM"
        ],
        "allowedDimensions": [
          "dim.region",
          "dim.channel",
          "dim.channel_name",
          "dim.order_date",
          "dim.customer_tier",
          "dim.product_category"
        ],
        "caliberVariants": [
          {
            "variantId": "metric.paid_gmv.online",
            "alias": [
              "线上支付口径",
              "线上 GMV"
            ],
            "condition": {
              "fieldId": "dim.channel",
              "operator": "EQ",
              "values": [
                "线上"
              ]
            },
            "version": "1.0.0"
          },
          {
            "variantId": "metric.paid_gmv.offline",
            "alias": [
              "线下支付口径",
              "线下 GMV"
            ],
            "condition": {
              "fieldId": "dim.channel",
              "operator": "EQ",
              "values": [
                "线下"
              ]
            },
            "version": "1.0.0"
          }
        ],
        "objectId": "concept.order",
        "propertyId": "property.order.amount"
      },
      {
        "id": "metric.gmv_created",
        "name": "GMV（下单口径）",
        "aliases": [
          "下单金额"
        ],
        "summary": "下单口径的成交金额：含未支付订单，与支付口径对比用",
        "sensitive": false,
        "aggregation": "SUM",
        "allowedModes": [
          "QUERY"
        ],
        "allowedDimensions": [
          "dim.region",
          "dim.channel",
