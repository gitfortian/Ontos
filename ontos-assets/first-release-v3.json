{
  "rules": [
    {
      "id": "rule.high_value_customer",
      "name": "高价值客户",
      "scope": "global",
      "status": "published",
      "summary": "累计消费金额满 5 万的客户",
      "reviewer": "m1-seed",
      "expression": {
        "metricId": "metric.gmv",
        "operator": "GTE",
        "threshold": 50000
      }
    }
  ],
