# 模型连接配置：复制为 .env.local 后填写（.env.local 已被 .gitignore 忽略，不会进仓库）
#
# 标准 OpenAI 三件套，不绑定厂商：把 base-url 指向任意兼容 /chat/completions 的服务即可。
# 例：阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1
#     DeepSeek    https://api.deepseek.com/v1
#     Kimi        https://api.moonshot.cn/v1
#     vLLM/Ollama http://127.0.0.1:8000/v1

ONTOS_AGENT_MODEL=gpt-4o-mini
ONTOS_AGENT_BASE_URL=https://api.openai.com/v1
ONTOS_AGENT_API_KEY=

# 兼容写法：不配 ONTOS_AGENT_* 时，也认 OPENAI_API_KEY / OPENAI_BASE_URL
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
