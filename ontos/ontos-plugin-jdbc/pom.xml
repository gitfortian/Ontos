<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ontos</groupId>
    <artifactId>ontos</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ontos-plugin-jdbc</artifactId>
  <name>ontos-plugin-jdbc</name>
  <description>内置 JDBC 数据源插件（B2）：PostgreSQL 首发；只做连接与元数据，不执行业务 SQL</description>

  <dependencies>
    <dependency>
      <groupId>com.ontos</groupId>
      <artifactId>ontos-spi-datasource</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 驱动只在运行期经 DriverManager 使用；编译期不得出现 JDBC 驱动类型，保持 SPI 纯净 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

</project>
